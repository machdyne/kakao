+		tick_n = tick_n + 1;
+		if (tick_n % 480000 == 0) $display("%0d ms", tick_n / 48000);
+	end
+`endif
+
+	// what the I/O processor types
+	integer n_got = 0, errors = 0;
+	reg [7:0] last_key = 0;
