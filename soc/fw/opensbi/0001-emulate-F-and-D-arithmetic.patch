+#include <stdbool.h>
+#include <stdint.h>
+#include "platform.h"
+#include "internals.h"
+#include "specialize.h"
+#include "softfloat.h"
+
+float64_t
+ softfloat_subMagsF64( uint_fast64_t uiA, uint_fast64_t uiB, bool signZ )
+{
+    int_fast16_t expA;
+    uint_fast64_t sigA;
+    int_fast16_t expB;
+    uint_fast64_t sigB;
+    int_fast16_t expDiff;
+    uint_fast64_t uiZ;
+    int_fast64_t sigDiff;
+    int_fast8_t shiftDist;
+    int_fast16_t expZ;
+    uint_fast64_t sigZ;
+    union ui64_f64 uZ;
+
+    /*------------------------------------------------------------------------
+    *------------------------------------------------------------------------*/
+    expA = expF64UI( uiA );
+    sigA = fracF64UI( uiA );
+    expB = expF64UI( uiB );
+    sigB = fracF64UI( uiB );
+    /*------------------------------------------------------------------------
+    *------------------------------------------------------------------------*/
+    expDiff = expA - expB;
+    if ( ! expDiff ) {
+        /*--------------------------------------------------------------------
+        *--------------------------------------------------------------------*/
+        if ( expA == 0x7FF ) {
+            if ( sigA | sigB ) goto propagateNaN;
+            softfloat_raiseFlags( softfloat_flag_invalid );
+            uiZ = defaultNaNF64UI;
+            goto uiZ;
+        }
+        sigDiff = sigA - sigB;
+        if ( ! sigDiff ) {
+            uiZ =
+                packToF64UI(
+                    (softfloat_roundingMode == softfloat_round_min), 0, 0 );
+            goto uiZ;
+        }
+        if ( expA ) --expA;
+        if ( sigDiff < 0 ) {
+            signZ = ! signZ;
+            sigDiff = -sigDiff;
+        }
+        shiftDist = softfloat_countLeadingZeros64( sigDiff ) - 11;
+        expZ = expA - shiftDist;
+        if ( expZ < 0 ) {
+            shiftDist = expA;
+            expZ = 0;
+        }
+        uiZ = packToF64UI( signZ, expZ, sigDiff<<shiftDist );
+        goto uiZ;
+    } else {
+        /*--------------------------------------------------------------------
+        *--------------------------------------------------------------------*/
+        sigA <<= 10;
+        sigB <<= 10;
+        if ( expDiff < 0 ) {
+            /*----------------------------------------------------------------
+            *----------------------------------------------------------------*/
+            signZ = ! signZ;
+            if ( expB == 0x7FF ) {
+                if ( sigB ) goto propagateNaN;
+                uiZ = packToF64UI( signZ, 0x7FF, 0 );
+                goto uiZ;
+            }
+            sigA += expA ? UINT64_C( 0x4000000000000000 ) : sigA;
+            sigA = softfloat_shiftRightJam64( sigA, -expDiff );
+            sigB |= UINT64_C( 0x4000000000000000 );
+            expZ = expB;
+            sigZ = sigB - sigA;
+        } else {
+            /*----------------------------------------------------------------
+            *----------------------------------------------------------------*/
+            if ( expA == 0x7FF ) {
+                if ( sigA ) goto propagateNaN;
+                uiZ = uiA;
+                goto uiZ;
+            }
+            sigB += expB ? UINT64_C( 0x4000000000000000 ) : sigB;
+            sigB = softfloat_shiftRightJam64( sigB, expDiff );
+            sigA |= UINT64_C( 0x4000000000000000 );
+            expZ = expA;
+            sigZ = sigA - sigB;
+        }
+        return softfloat_normRoundPackToF64( signZ, expZ - 1, sigZ );
+    }
+    /*------------------------------------------------------------------------
+    *------------------------------------------------------------------------*/
+ propagateNaN:
+    uiZ = softfloat_propagateNaNF64UI( uiA, uiB );
+ uiZ:
+    uZ.ui = uiZ;
+    return uZ.f;
+
+}
+
diff --git a/lib/sbi/softfloat/sf_exec.c b/lib/sbi/softfloat/sf_exec.c
new file mode 100644
index 0000000..cf4ffe8
--- /dev/null
+++ b/lib/sbi/softfloat/sf_exec.c
@@ -0,0 +1,167 @@
+/*
+ * SPDX-License-Identifier: BSD-2-Clause
+ *
+ * One trapped floating-point instruction, done with SoftFloat: this
+ * file is on SoftFloat's side of the fence (its types, <stdint.h>),
+ * lib/sbi/sbi_fp_emu.c on OpenSBI's.
+ */
+
+#include <stdbool.h>
+#include <stdint.h>
+#include "platform.h"
+#include "softfloat.h"
+
+typedef uint64_t u64;
+typedef uint32_t u32;
+typedef int32_t s32;
+typedef unsigned long ulong;
+
+#define F32_SIGN	0x80000000U
+#define F64_SIGN	0x8000000000000000UL
+#define F32_QNAN	0x7fc00000U
+#define F64_QNAN	0x7ff8000000000000UL
+
+/* a single in a register: the low word, if the high word is all ones */
+static inline float32_t unbox(u64 r)
+{
+	float32_t f;
+	f.v = ((r >> 32) == 0xffffffffU) ? (u32)r : F32_QNAN;
+	return f;
+}
+
+static inline u64 box(float32_t f)
+{
+	return 0xffffffff00000000UL | f.v;
+}
+
+static inline bool nan32(float32_t a) { return (a.v & 0x7fffffffU) > 0x7f800000U; }
+static inline bool nan64(float64_t a) { return (a.v & ~F64_SIGN) > 0x7ff0000000000000UL; }
+
+static float32_t minmax32(float32_t a, float32_t b, bool max)
+{
+	float32_t r;
+	bool pick = max ?
+		(f32_lt_quiet(b, a) || (f32_eq(b, a) && (b.v & F32_SIGN))) :
+		(f32_lt_quiet(a, b) || (f32_eq(a, b) && (a.v & F32_SIGN)));
+	if (nan32(a) && nan32(b))
+		r.v = F32_QNAN;
+	else
+		r = (pick || nan32(b)) ? a : b;
+	return r;
+}
+
+static float64_t minmax64(float64_t a, float64_t b, bool max)
+{
+	float64_t r;
+	bool pick = max ?
+		(f64_lt_quiet(b, a) || (f64_eq(b, a) && (b.v & F64_SIGN))) :
+		(f64_lt_quiet(a, b) || (f64_eq(a, b) && (a.v & F64_SIGN)));
+	if (nan64(a) && nan64(b))
+		r.v = F64_QNAN;
+	else
+		r = (pick || nan64(b)) ? a : b;
+	return r;
+}
+
+/*
+ * insn: the instruction (already known to be one of ours); rm: its
+ * rounding mode, resolved; a, b, c: the f registers rs1, rs2, rs3; x:
+ * the integer register rs1. Returns the f register to write, or the
+ * integer; *flags: what to set in fflags.
+ */
+unsigned long sbi_sf_exec(unsigned long insn, unsigned rm, unsigned long a,
+			  unsigned long b, unsigned long c, unsigned long x,
+			  unsigned *flags)
+{
+	u32 op = insn & 0x7f, f5 = (insn >> 27) & 0x1f, rs2n = (insn >> 20) & 0x1f;
+	bool dbl = ((insn >> 25) & 3) == 1, fused = (op != 0x53), to_int = false;
+	float64_t a64, b64, c64, r64;
+	float32_t a32, b32, c32, r32;
+	ulong ri = 0;
+
+	softfloat_roundingMode = rm;
+	softfloat_exceptionFlags = 0;
+	a64.v = a;
+	b64.v = b;
+	a32 = unbox(a);
+	b32 = unbox(b);
+	r64.v = 0;
+	r32.v = 0;
+
+	if (fused) {
+		/* fmadd a*b+c, fmsub a*b-c, fnmsub -(a*b)+c, fnmadd -(a*b)-c */
+		bool neg_p = (op == 0x4b || op == 0x4f), neg_c = (op == 0x47 || op == 0x4f);
+		c64.v = c;
+		c32 = unbox(c64.v);
+		if (dbl) {
+			if (neg_p) a64.v ^= F64_SIGN;
+			if (neg_c) c64.v ^= F64_SIGN;
+			r64 = f64_mulAdd(a64, b64, c64);
+		} else {
+			if (neg_p) a32.v ^= F32_SIGN;
+			if (neg_c) c32.v ^= F32_SIGN;
+			r32 = f32_mulAdd(a32, b32, c32);
+		}
+	} else switch (f5) {
+	case 0x00:
+		if (dbl) r64 = f64_add(a64, b64); else r32 = f32_add(a32, b32);
+		break;
+	case 0x01:
+		if (dbl) r64 = f64_sub(a64, b64); else r32 = f32_sub(a32, b32);
+		break;
+	case 0x02:
+		if (dbl) r64 = f64_mul(a64, b64); else r32 = f32_mul(a32, b32);
+		break;
+	case 0x03:
+		if (dbl) r64 = f64_div(a64, b64); else r32 = f32_div(a32, b32);
+		break;
+	case 0x0b:
+		if (dbl) r64 = f64_sqrt(a64); else r32 = f32_sqrt(a32);
+		break;
+	case 0x05:
+		if (dbl) r64 = minmax64(a64, b64, rm == 1); else r32 = minmax32(a32, b32, rm == 1);
+		break;
+	case 0x08:
+		if (dbl) r64 = f32_to_f64(a32); else r32 = f64_to_f32(a64);
+		break;
+	case 0x18:
+		to_int = true;
+		switch (rs2n) {
+		case 0:
+			ri = (long)(s32)(dbl ? f64_to_i32(a64, rm, true) : f32_to_i32(a32, rm, true));
+			break;
+		case 1:
+			ri = (long)(s32)(dbl ? f64_to_ui32(a64, rm, true) : f32_to_ui32(a32, rm, true));
+			break;
+		case 2:
+			ri = dbl ? f64_to_i64(a64, rm, true) : f32_to_i64(a32, rm, true);
+			break;
+		default:
+			ri = dbl ? f64_to_ui64(a64, rm, true) : f32_to_ui64(a32, rm, true);
+			break;
+		}
+		break;
+	default: {	/* 0x1a */
+		switch (rs2n) {
+		case 0:
+			if (dbl) r64 = i32_to_f64((s32)x); else r32 = i32_to_f32((s32)x);
+			break;
+		case 1:
+			if (dbl) r64 = ui32_to_f64((u32)x); else r32 = ui32_to_f32((u32)x);
+			break;
+		case 2:
+			if (dbl) r64 = i64_to_f64(x); else r32 = i64_to_f32(x);
+			break;
+		default:
+			if (dbl) r64 = ui64_to_f64(x); else r32 = ui64_to_f32(x);
+			break;
+		}
+		break;
+	}
+	}
+
+	*flags = softfloat_exceptionFlags;
+	if (to_int)
+		return ri;
+	return dbl ? r64.v : box(r32);
+}
