+			hmem[B + 64] = { 16'd8, 16'd0 };
+			for (i = 0; i < 4; i = i + 1) hmem[B + 65 + i] = ((2*i + 1) << 16) | (2*i);
+			// the status queue: one descriptor, the driver's to fill
+			hmem[B + 512] = ha(B + 768); hmem[B + 513] = 32'd0; hmem[B + 514] = 32'd8; hmem[B + 515] = 32'd0;
+			hmem[B + 576] = 32'd0;
+			hmem[B + 577] = 32'd0;
