# The kernel for the Kakao SOC with the kakao64 CPU (soc/docs/kakao64.md):
# a machine like QEMU's RISC-V "virt", RV64 with C, one hart. Its
# consoles are 16550s (the 8250 driver), its interrupts a PLIC. Floating
# point is used where the device tree says the hart has it. With what
# Debian's systemd asks of a kernel.

# Architecture
CONFIG_64BIT=y
CONFIG_ARCH_RV64I=y
CONFIG_SOC_VIRT=y
CONFIG_RISCV_ISA_C=y
CONFIG_FPU=y
# CONFIG_SMP is not set
# CONFIG_EFI is not set
# CONFIG_RISCV_ISA_V is not set
# CONFIG_STRICT_KERNEL_RWX is not set
CONFIG_HZ_100=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_PRINTK_TIME=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# The root file system in memory
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Consoles: ten 16550s at most (the terminals), and SBI's early on
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=10
CONFIG_SERIAL_8250_RUNTIME_UARTS=10
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
CONFIG_HVC_RISCV_SBI=y

# Power off and restart through the test device
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_SYSCON=y
CONFIG_POWER_RESET_SYSCON_POWEROFF=y

# Network
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_NETDEVICES=y

# What the I/O processor will offer: virtio devices
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_INPUT=y

# The SD card on SPI
CONFIG_SPI=y
CONFIG_MMC=y
CONFIG_MMC_SPI=y

# File systems
CONFIG_EXT4_FS=y
CONFIG_MSDOS_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_CODEPAGE=437
CONFIG_FAT_DEFAULT_IOCHARSET="iso8859-1"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_TMPFS=y
CONFIG_MSDOS_PARTITION=y

# systemd
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_NET_NS=y
CONFIG_INOTIFY_USER=y
CONFIG_FHANDLE=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_SECCOMP=y
CONFIG_IPV6=y
CONFIG_BPF_SYSCALL=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_EFI_PARTITION=y
CONFIG_SWAP=y
CONFIG_UNIX98_PTYS=y
CONFIG_RTC_CLASS=y
