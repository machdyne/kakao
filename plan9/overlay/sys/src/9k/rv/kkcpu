#KKBIN	(the Makefile puts every command of /riscv64/bin here)

conf
	#include "riscv64.h"

	int cpuserver = 1;
	uvlong cpuhz = 48*MHZ;
	uvlong timebase = 10*MHZ;	/* clint ticks per second: QEMU's */
	Membank membanks[] = {		/* (address, size) pairs */
		PHYSMEM, BANK0SIZE,
		0
	};
	char defnvram[] = "/boot/nvram";

	uintptr uartregs[] = { PAUart0 };
	int nuart = nelem(uartregs);
	vlong uartfreq = 3686400;

	uchar ether0mac[] = { 2, 0x4b, 0x4b, 0, 0, 0 };	/* the last three are made up */

	Soc soc = {
		.plic	= (char *)0x0c000000,

		.hobbled = 0,		/* one hart, contexts M then S */
	};
	Ioconf socconf[] = { /* devices without drivers that vmap their regs */
		{ "clint", 64*KB, &soc.clint, },
		{ "uart",  PGSZ, &soc.uart, 10, },
		{ "plic",  64*MB, &soc.plic, },
		0
	};
	Ioconf ioconfs[] = {	/* devices whose drivers vmap their regs */
		0
	};

