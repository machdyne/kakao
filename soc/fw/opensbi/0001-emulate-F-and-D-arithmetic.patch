diff --git a/lib/sbi/sbi_fp_emu.c b/lib/sbi/sbi_fp_emu.c
new file mode 100644
index 0000000..b55bf75
--- /dev/null
+++ b/lib/sbi/sbi_fp_emu.c
@@ -0,0 +1,101 @@
+/*
+ * SPDX-License-Identifier: BSD-2-Clause
+ *
+ * Floating-point arithmetic for a hart that has the F and D registers,
+ * their loads, stores, moves and compares, but traps on the rest: the
+ * arithmetic, square root, fused multiply-add, min/max and the
+ * conversions, in single and double precision. Done with Berkeley
+ * SoftFloat (lib/sbi/softfloat, release 3e, its RISC-V specialization),
+ * which is what the ISA simulator uses.
+ *
+ * An instruction that arrives with mstatus.FS off, or that is not one
+ * of these, is passed on as illegal.
+ */
+
+#include <sbi/riscv_asm.h>
+#include <sbi/riscv_encoding.h>
+#include <sbi/riscv_fp.h>
+#include <sbi/sbi_error.h>
+#include <sbi/sbi_trap.h>
+#include <sbi/sbi_illegal_insn.h>
+
+#if defined(__riscv_flen) && __riscv_flen == 64 && __riscv_xlen == 64
+
+unsigned long sbi_sf_exec(unsigned long insn, unsigned rm, unsigned long a,
+			  unsigned long b, unsigned long c, unsigned long x,
+			  unsigned *flags);
+
+int sbi_fp_emulate(ulong insn, struct sbi_trap_regs *regs)
+{
+	u32 op = insn & 0x7f, f5 = (insn >> 27) & 0x1f, fmt = (insn >> 25) & 3;
+	u32 rm = (insn >> 12) & 7, rs2n = (insn >> 20) & 0x1f;
+	bool dbl = (fmt == PRECISION_D), fused = (op != 0x53);
+	bool to_int = false, rm_used = true;
+	ulong a, b, c = 0, r;
+	unsigned flags = 0;
+
+	if (!(regs->mstatus & MSTATUS_FS) || fmt > PRECISION_D ||
+	    sbi_mstatus_prev_mode(regs->mstatus) == PRV_M)
+		return truly_illegal_insn(insn, regs);
+
+	/* which it is, before anything is touched */
+	if (!fused) {
+		switch (f5) {
+		case 0x00: case 0x01: case 0x02: case 0x03:	/* add sub mul div */
+			break;
+		case 0x0b:					/* sqrt */
+			if (rs2n != 0)
+				return truly_illegal_insn(insn, regs);
+			break;
+		case 0x05:					/* min max */
+			if (rm > 1)
+				return truly_illegal_insn(insn, regs);
+			rm_used = false;
+			break;
+		case 0x08:					/* fcvt.s.d, fcvt.d.s */
+			if (rs2n != (dbl ? 0 : 1))
+				return truly_illegal_insn(insn, regs);
+			break;
+		case 0x18:					/* to an integer */
+			to_int = true;
+			/* fallthrough */
+		case 0x1a:					/* from an integer */
+			if (rs2n > 3)
+				return truly_illegal_insn(insn, regs);
+			break;
+		default:
+			return truly_illegal_insn(insn, regs);
+		}
+	}
+	if (rm_used) {
+		if (rm == 7)
+			rm = GET_FRM();
+		if (rm > 4)
+			return truly_illegal_insn(insn, regs);
+	}
+
+	a = GET_F64_RS1(insn, regs);
+	b = GET_F64_RS2(insn, regs);
+	if (fused)
+		c = GET_F64_RS3(insn, regs);
+	r = sbi_sf_exec(insn, rm, a, b, c, GET_RS1(insn, regs), &flags);
+
+	if (to_int)
+		SET_RD(insn, regs, r);
+	else
+		SET_F64_RD(insn, regs, r);
+	if (flags)
+		csr_set(CSR_FFLAGS, flags);
+	SET_FS_DIRTY(regs);
+	regs->mepc += 4;
+	return 0;
+}
+
+#else
+
+int sbi_fp_emulate(ulong insn, struct sbi_trap_regs *regs)
+{
+	return truly_illegal_insn(insn, regs);
+}
+
+#endif
